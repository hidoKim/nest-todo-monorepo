PORT=3000
# 쉼표(,)로 여러 origin 지정 가능. 예: https://app.example.com,https://staging.example.com
CORS_ORIGIN=http://localhost:3001
# "오늘/내일/이번주" 산출 기준 timezone. IANA 식별자.
APP_TIMEZONE=Asia/Seoul
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=todo_db
SQLITE_DB=todo.sqlite
DB_SYNCHRONIZE=true
