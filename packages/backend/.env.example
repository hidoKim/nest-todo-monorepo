# 서버
PORT=3000
# production이면 쿠키가 secure + sameSite=none으로 발급된다 (cross-site 배포 필수).
# 로컬은 비워두거나 development.
NODE_ENV=development
# 쉼표(,)로 여러 origin 지정 가능. 예: https://app.example.com,https://staging.example.com
# httpOnly 쿠키 흐름이 동작하려면 와일드카드(*)는 불가. 정확한 도메인을 명시한다.
CORS_ORIGIN=http://localhost:3001
# "오늘/내일/이번주" 산출 기준 timezone. IANA 식별자.
APP_TIMEZONE=Asia/Seoul
# OAuth 콜백 후 redirect 대상.
FRONTEND_URL=http://localhost:3001

# DB
# sqlite(로컬 기본) | postgres(배포). postgres면 아래 DATABASE_URL 우선.
DB_TYPE=sqlite
# Neon 등 관리형 Postgres는 연결 URL 통째로 넣는다. DB_TYPE=postgres일 때 사용.
# 예: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# 설정 시 아래 DB_HOST/PORT/USERNAME/PASSWORD/NAME은 무시된다.
DATABASE_URL=
# DATABASE_URL이 없을 때의 개별 접속 정보 (로컬 docker-compose 등).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=todo_db
SQLITE_DB=todo.sqlite
# 첫 배포 때 true로 테이블 자동 생성 → 이후 false 권장 (운영 중 스키마 유실 방지).
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Kakao OAuth (https://developers.kakao.com)
KAKAO_CLIENT_ID=
KAKAO_CALLBACK_URL=http://localhost:3000/auth/kakao/callback
